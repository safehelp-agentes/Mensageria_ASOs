# =============================================================================
# SafeWork — Envio ASO  |  Copie este arquivo para .env e preencha os valores
# =============================================================================


# ── SOC — URL base (opcional) ─────────────────────────────────────────────────
# Padrão já embutido no código — só altere se o SOC mudar de endereço
SOC_URL=https://ws1.soc.com.br/WebSoc/exportadados


# ── SOC — Identificação da empresa e credenciais SOAP ────────────────────────
# Código da empresa principal no SOC (usado como "empresa" em todas as chamadas)
SOC_EMPRESA=

# Código interno do responsável e do usuário (necessários para download SOAP)
SOC_CODIGO_RESPONSAVEL=
SOC_CODIGO_USUARIO=

# Usuário e senha para autenticação SOAP (WS-Security)
# Também usado pela automação Playwright para login na interface web
SOC_WS_USUARIO=
SOC_WS_PASSWORD=


# ── SOC — WebService ImportacaoEmpresa (SOAP) ────────────────────────────────
# Endpoint do serviço de importação/atualização de empresas
# Padrão já embutido no código — só altere se o SOC mudar de endereço
SOC_IMPORTACAO_EMPRESA_URL=https://ws1.soc.com.br/WSSoc/ImportacaoEmpresaWs

# chaveAcesso para identificacaoWsVo — opcional conforme o WSDL (minOccurs=0)
# Se o SOC exigir, obter na tela 337 / configuração de acesso WS
SOC_CHAVE_IMPORTACAO_EMPRESA=

# true = envia requisições para ambiente de homologação do SOC (padrão: false = produção)
SOC_HOMOLOGACAO=false


# ── SOC — Chaves dos Exportadores (pipeline) ──────────────────────────────────
# Exportador 192392 — Lista de empresas clientes
SOC_CHAVE_EMPRESAS=

# Exportador 191710 — ASOs / GED (arquivos PDF)
SOC_CHAVE_GED=

# Exportador 193815 — Contatos das empresas (telefones para envio)
SOC_CHAVE_CONTATOS=

# Exportador 200410 — Dados financeiros/contrato (verifica flagClienteInadimplente
# antes do envio; empresa inadimplente não recebe ASO)
SOC_CHAVE_PRECO=

# Parâmetros extras do exportador de contatos (opcional)
# SOC_EXPORTA_CONTATOS_USUARIO: padrão = SOC_CODIGO_USUARIO
SOC_EXPORTA_CONTATOS_USUARIO=
SOC_EXPORTA_CONTATOS_IDENTIFICACAO=
SOC_EXPORTA_CONTATOS_CODIGO_PERFIL=


# ── Meta / WhatsApp Business ──────────────────────────────────────────────────
# Token Bearer do app Meta Business (developers.facebook.com → App → WhatsApp → Access Token)
META_WA_TOKEN=

# ID do número de telefone WhatsApp Business
META_PHONE_NUMBER_ID=

# Nome exato do template aprovado na Meta (ex: aso_envio)
META_TEMPLATE_NAME=

# Número de destino quando ENVIO_REAL_EMPRESAS=false (formato: 5511999999999)
META_NUMERO_TESTE=

# Controles de envio — mantenha false até validar tudo em homologação
META_ENVIAR=false
ENVIO_REAL_EMPRESAS=false

# true para simular o fluxo completo sem baixar PDF real (testes de integração)
META_TESTAR_SEM_ASO=false


# ── Inbox (visualizador read-only de mensagens) ──────────────────────────────
# Verify token do webhook da Meta — string secreta qualquer que você define.
# O MESMO valor precisa ser colado no painel Meta (WhatsApp → Configuration →
# Webhook → Verify token) ao apontar a Callback URL para https://inbox.<dominio>/webhook
# Gere um com: python -c "import secrets; print('safework_inbox_' + secrets.token_urlsafe(24))"
WEBHOOK_VERIFY_TOKEN=

# Token para integracoes internas registrarem mensagens no inbox via
# POST /api/internal/mensagem. Use um valor longo e aleatorio.
INBOX_INTERNAL_TOKEN=


# ── Supabase ──────────────────────────────────────────────────────────────────
# URL do projeto (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=

# Chave service_role — usada pelo pipeline para gravar ASOs e empresas no banco
# NUNCA exponha esta chave em frontend/browser — ela bypassa o Row Level Security
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=

# Chave anon/public — usada pelo pipeline (src/integrations/supabase.py)
# Supabase → Project Settings → API → anon / public
SUPABASE_SECRET_KEY=


# ── Google Sheets (cadastro de contatos via Forms) ────────────────────────────
# Caminho para o JSON da service account (Google Cloud → IAM → Service Accounts)
GOOGLE_CREDENTIALS_JSON=testes/credentials.json

# ID da planilha (extraído da URL do Google Sheets)
GOOGLE_SHEETS_ID=1hYZkL60P9ixyqQvoBMYhHn0_zK3_33cOJB-aQpv_muc

# GID da aba com as respostas do Forms
GOOGLE_SHEETS_GID=1753505458
