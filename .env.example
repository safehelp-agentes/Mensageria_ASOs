# ── SOC API ──────────────────────────────────────────────────────────────────
SOC_EMPRESA=               # Código da empresa principal no SOC
SOC_CODIGO_EMPRESA_PRINCIPAL=   # Código interno (mesmo que SOC_EMPRESA na maioria dos casos)
SOC_CODIGO_RESPONSAVEL=    # Código do responsável no SOC
SOC_CODIGO_USUARIO=        # Código do usuário no SOC

SOC_CHAVE_EMPRESAS=        # Chave exportador 192392
SOC_CHAVE_GED=             # Chave exportador 191710 (ASOs)
SOC_CHAVE_CONTATOS=        # Chave exportador 193815
SOC_CHAVE_FUNCIONARIOS=    # Chave exportador 192399 (Cadastro de Funcionários por Empresa)

SOC_WS_USUARIO=            # Usuário SOAP
SOC_WS_PASSWORD=           # Senha SOAP

# ── Meta / WhatsApp ───────────────────────────────────────────────────────────
META_WA_TOKEN=             # Token Bearer do app Meta Business
META_PHONE_NUMBER_ID=      # ID do número WhatsApp Business
META_TEMPLATE_NAME=        # Nome do template aprovado (ex: aso_envio)
META_NUMERO_TESTE=         # Número destino quando ENVIO_REAL_EMPRESAS=false (ex: 5511999999999)
META_ENVIAR=false          # true para enviar de fato
ENVIO_REAL_EMPRESAS=false  # true libera envio aos números reais (dupla proteção)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=              # https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=       # service_role key — NUNCA expor no frontend (só backend/pipeline)
SUPABASE_ANON_KEY=         # anon/public key — usada pelo build.py para o CRM (index.html)

# ── Alertas por e-mail (opcional) ─────────────────────────────────────────────
EMAIL_REMETENTE=           # Conta Gmail que envia o relatório
EMAIL_SENHA_APP=           # App Password do Gmail
EMAIL_DESTINO=             # Destinatário do relatório de erros
EMAIL_ENVIAR=false

# ── Bot de atendimento ────────────────────────────────────────────────────────
GROQ_API_KEY=              # Chave da API Groq (console.groq.com — gratuito)
BOT_ATIVO=true             # false para desligar o bot sem parar o serviço
BOT_NUMEROS_TESTE=         # Quando preenchido, bot só responde esses números. Ex: 5511999999999,5521888888888
BOT_PORT=8001              # Porta do serviço FastAPI
BOT_MODEL=llama-3.3-70b-versatile  # Modelo Groq
