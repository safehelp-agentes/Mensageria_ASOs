# =============================================================================
# SafeWork — Envio ASO  |  Copie este arquivo para .env e preencha os valores
# =============================================================================


# ── SOC — URL base (opcional) ─────────────────────────────────────────────────
# Padrão já embutido no código — só altere se o SOC mudar de endereço
SOC_URL=https://ws1.soc.com.br/WebSoc/exportadados


# ── SOC — Identificação da empresa e credenciais SOAP ────────────────────────
# Código da empresa principal no SOC (usado como "empresa" em todas as chamadas)
SOC_EMPRESA=

# Código interno do responsável e do usuário (necessários para download SOAP)
SOC_CODIGO_RESPONSAVEL=
SOC_CODIGO_USUARIO=

# Usuário e senha para autenticação SOAP (WS-Security)
SOC_WS_USUARIO=
SOC_WS_PASSWORD=


# ── SOC — Chaves dos Exportadores (pipeline) ──────────────────────────────────
# Exportador 192392 — Lista de empresas clientes
SOC_CHAVE_EMPRESAS=

# Exportador 191710 — ASOs / GED (arquivos PDF)
SOC_CHAVE_GED=

# Exportador 193815 — Contatos das empresas (telefones para envio)
SOC_CHAVE_CONTATOS=

# Parâmetros extras do exportador de contatos (opcional)
# SOC_EXPORTA_CONTATOS_USUARIO: padrão = SOC_CODIGO_USUARIO
SOC_EXPORTA_CONTATOS_USUARIO=
SOC_EXPORTA_CONTATOS_IDENTIFICACAO=
SOC_EXPORTA_CONTATOS_CODIGO_PERFIL=


# ── SOC — Chaves dos Exportadores (bot de atendimento) ───────────────────────
# Exportador 192399 — Cadastro de funcionários por empresa (busca por nome)
SOC_CHAVE_FUNCIONARIOS=

# Exportador 193037 — ASOs do funcionário (tipo: Admissional, Periódico etc.)
SOC_CHAVE_ASO_FUNCIONARIO=

# Exportador 215872 — Contatos WhatsApp (valida se o número está cadastrado no SOC)
# Deixe vazio para usar o valor padrão já embutido no código
SOC_CHAVE_CONTATOS_WA=


# ── Meta / WhatsApp Business ──────────────────────────────────────────────────
# Token Bearer do app Meta Business (developers.facebook.com → App → WhatsApp → Access Token)
META_WA_TOKEN=

# ID do número de telefone WhatsApp Business
META_PHONE_NUMBER_ID=

# Nome exato do template aprovado na Meta (ex: aso_envio)
META_TEMPLATE_NAME=

# Número de destino quando ENVIO_REAL_EMPRESAS=false (formato: 5511999999999)
META_NUMERO_TESTE=

# Controles de envio — mantenha false até validar tudo em homologação
META_ENVIAR=false
ENVIO_REAL_EMPRESAS=false

# true para simular o fluxo completo sem baixar PDF real (testes de integração)
META_TESTAR_SEM_ASO=false


# ── Supabase ──────────────────────────────────────────────────────────────────
# URL do projeto (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=

# Chave service_role — usada pelo pipeline para gravar ASOs e empresas no banco
# NUNCA coloque esta chave no CRM (frontend) — ela bypassa o Row Level Security
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=

# Chave anon/public — usada pelo pipeline (src/integrations/supabase.py)
# Supabase → Project Settings → API → anon / public
SUPABASE_SECRET_KEY=

# Chave anon/public — usada pelo build.py para gerar o CRM (index.html)
# Geralmente o mesmo valor de SUPABASE_SECRET_KEY acima
SUPABASE_ANON_KEY=


# ── Bot de atendimento (FastAPI + Groq) ───────────────────────────────────────
# Chave da API Groq para interpretação de linguagem natural
# Gratuito em: console.groq.com
GROQ_API_KEY=

# false para desligar o bot sem parar o serviço (útil em manutenção)
BOT_ATIVO=true

# Quando preenchido, o bot só responde esses números (modo de teste)
# Separe múltiplos com vírgula: 5511999999999,5521888888888
# Deixe vazio para liberar para todos os números cadastrados no SOC
BOT_NUMEROS_TESTE=

# Porta do serviço FastAPI (padrão: 8001)
BOT_PORT=8001

# Modelo Groq utilizado para interpretar as mensagens
BOT_MODEL=llama-3.3-70b-versatile


# ── Alertas por e-mail (opcional) ─────────────────────────────────────────────
# Conta Gmail que envia o relatório de erros do pipeline
EMAIL_REMETENTE=

# App Password do Gmail (myaccount.google.com/apppasswords)
EMAIL_SENHA_APP=

# Destinatário do relatório de erros
EMAIL_DESTINO=

# false para não enviar e-mail mesmo que haja erros
EMAIL_ENVIAR=false
