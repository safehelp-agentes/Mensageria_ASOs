# =============================================================================
# Chatwoot — Variáveis de ambiente
# Copie este arquivo para .env.chatwoot e preencha os valores
# =============================================================================

# Chave secreta da aplicação Rails — gere com: openssl rand -hex 64
SECRET_KEY_BASE=6c546924e9f851d84da673b0b74ed875ed5e9d78ce09668613e3cc2521ea728ba4805b935e176da36eddba3d9800eec3277ed62082c5e615df453336632a27fd

# URL pública do Chatwoot (usada nos links de e-mail etc.)
FRONTEND_URL=https://chat.srv1564091.hstgr.cloud

# Idioma padrão da interface
DEFAULT_LOCALE=pt_BR

# Forçar HTTPS (true quando atrás de proxy TLS como Traefik)
FORCE_SSL=true

# Banco de dados (credenciais do postgres no docker-compose)
POSTGRES_HOST=chatwoot_postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=0c04d37b4aef3e55a3efb4fdec85b81d7f8fe27ae602be63

# Mesma senha — usada pelo docker-compose para criar o banco
CHATWOOT_DB_PASSWORD=0c04d37b4aef3e55a3efb4fdec85b81d7f8fe27ae602be63

# Redis
REDIS_URL=redis://chatwoot_redis:6379

# ── E-mail SMTP (necessário para criar a conta admin) ─────────────────────────
# Você pode usar a mesma conta Gmail do projeto
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=processos4.soc@gpsafework.com.br
SMTP_PASSWORD=qpolyxihmijlpixw
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL=processos4.soc@gpsafework.com.br
MAILER_INBOUND_EMAIL_DOMAIN=

# ── Opções de produção ─────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
ACTIVE_STORAGE_SERVICE=local

# Desabilita telemetria
DISABLE_TELEMETRY=true

