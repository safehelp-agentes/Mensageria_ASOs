        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Responder hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 160]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meta-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Webhook Mensagens Meta (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 340]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-has-messages",
              "leftValue": "={{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "É mensagem? (não status)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 420]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst value = body?.entry?.[0]?.changes?.[0]?.value;\n\nif (!value?.messages?.length) return [];\n\nconst resultados = [];\n\nfor (const message of value.messages) {\n  const contact = value.contacts?.find(c => c.wa_id === message.from);\n  const numero  = message.from;\n  const wamid   = message.id;\n  const timestamp = parseInt(message.timestamp) || null;\n  const tipo    = message.type || 'text';\n\n  let conteudo = '';\n  if (tipo === 'text') {\n    conteudo = message.text?.body || '';\n  } else if (tipo === 'document') {\n    conteudo = '[documento] ' + (message.document?.filename || '');\n  } else if (tipo === 'image') {\n    conteudo = '[imagem] ' + (message.image?.caption || '');\n  } else if (tipo === 'audio') {\n    conteudo = '[áudio]';\n  } else if (tipo === 'video') {\n    conteudo = '[vídeo] ' + (message.video?.caption || '');\n  } else if (tipo === 'sticker') {\n    conteudo = '[sticker]';\n  } else {\n    conteudo = '[' + tipo + ']';\n  }\n\n  resultados.push({\n    json: {\n      numero_whatsapp: '+' + numero,\n      direcao:         'inbound',\n      tipo:            tipo,\n      conteudo:        conteudo,\n      wamid:           wamid,\n      timestamp_meta:  timestamp,\n      nome_empresa:    contact?.profile?.name || '',\n      codigo_empresa:  '',\n      nome_arquivo:    ''\n    }\n  });\n}\n\nreturn resultados;"
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Extrair dados da mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/mensagens",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SECRET_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SECRET_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Salvar no Supabase",
